# --- Database (Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campuspreps

# --- Auth.js / Google OAuth ---
# Generate a secret with: npx auth secret
AUTH_SECRET=
# From Google Cloud Console → APIs & Services → Credentials (OAuth 2.0 Client)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (contact form) ---
EMAIL_USER=
EMAIL_PASS=
RECIPIENT_EMAIL=

# --- Google AI (chat assistant) ---
GOOGLE_API_KEY=
